# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# Rust / flutter_rust_bridge
# ---------------------------------------------------------------------------
/rust/target/
/rust/Cargo.lock.bak

# FRB generated artifacts -- regenerated by `flutter_rust_bridge_codegen generate`.
# Kept under version control for now (small, stable); uncomment to ignore if
# they become noisy during development.
# /rust/src/frb_generated.rs
# /rust/src/frb_generated.io.rs
# /lib/src/rust/

# Bundled native libraries / model files (downloaded at runtime, not committed)
*.so
*.dylib
*.dll
/assets/models/
# OCR models staged for Windows packaging (download_ocr_models.ps1 -Dir)
/rust/models/

# ---------------------------------------------------------------------------
# Runtime data (never commit user data / DBs / logs)
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
/.local/

# ---------------------------------------------------------------------------
# Linux packaging (regenerated by scripts/build_packages.sh)
# ---------------------------------------------------------------------------
/dist/
/.packaging/
/.packaging-tools/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
*.orig
*~
.vscode/
.fvm/

# Local env files
.env
.env.local

# ZCode agent session state (not project code)
.zcode/
