+def _item_scope_source_text(item: dict) -> str:
+    """The item's OWN source text (fragment scope), not the merged unit.
+
+    [unit_source_text] returns the whole continuation unit for group members;
+    length-based checks must not compare an item's own translation against the
+    merged multi-block paragraph (see `_review_translated_text`).
+    """
+    return str(
+        item.get("protected_source_text")
+        or item.get("source_text")
+        or ""
+    ).strip()
