<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8.0+).

  Foreground: the app artwork at ~66% of the 108dp canvas, so it stays inside
  the safe zone for every OEM mask (circle / squircle / teardrop / rounded
  square). Background: the artwork's own near-white plate colour, so a masked
  icon still reads as one solid tile.

  Android 7 and below fall back to mipmap-*/ic_launcher.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <!-- Android 13+ themed icon: falls back to the plain foreground when the
         system has no monochrome treatment to apply. -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
